const FONT = '"Source Han Sans SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif'

<Slide style={{ width: 1280, height: 720, padding: '20px 64px', fontFamily: FONT, background: '#F8FAFC' }}>
  <Box style={{ flexDirection: 'row', gap: 28, height: 620 }}>
    {/* 左侧深色标题栏 */}
    <Box style={{ width: 366, height: 620, background: '#0F172A', borderRadius: 16, padding: 44, justifyContent: 'space-between' }}>
      <Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.3 }}>四项关键技术</Text>
        <Box style={{ width: 56, height: 4, background: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)', borderRadius: 2, marginTop: 24 }} />
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.8, marginTop: 24 }}>
          每项技术都回答「是什么」与「解决什么」——不为技术而技术，指标可复测。
        </Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 10, height: 10, borderRadius: 2, background: 'linear-gradient(135deg, #3B82F6, #06B6D4)' }} />
        <Text style={{ fontSize: 13, color: '#475569' }}>计划书 4.1 / 4.5 落地</Text>
      </Box>
    </Box>

    {/* 右侧四项技术 */}
    <Box style={{ flex: 1, height: 620, justifyContent: 'space-between' }}>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 14, padding: '16px 20px', borderLeft: '4px solid #3B82F6' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F172A' }}>RAG 两阶段检索</Text>
        <Text style={{ fontSize: 15, color: '#64748B', marginTop: 6, lineHeight: 1.65 }}>
          FAISS 粗排召回 40 条，规则重排叠加同领域 / 同风格先验取 Top-5 进入提示词。解决「素材找不准」：离线口径全量 180 条命中率 100%，消融显示重排贡献 +38.9pp。
        </Text>
      </Box>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 14, padding: '16px 20px', borderLeft: '4px solid #3B82F6' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F172A' }}>LangChain LCEL 编排</Text>
        <Text style={{ fontSize: 15, color: '#64748B', marginTop: 6, lineHeight: 1.65 }}>
          提示词模板化组装与多版本解析走标准 Runnable，向量检索与重排保留自研以保证可控与离线可跑。解决「链路不可复现」：离线 Mock 与生产走同一条编排路径。
        </Text>
      </Box>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 14, padding: '16px 20px', borderLeft: '4px solid #3B82F6' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F172A' }}>字段级加密（Fernet）</Text>
        <Text style={{ fontSize: 15, color: '#64748B', marginTop: 6, lineHeight: 1.65 }}>
          素材正文 / 分块加密落库，密钥经环境变量与数据分离；用户口令 PBKDF2 哈希。解决「素材资产安全」：数据库文件外泄不泄露正文，且不影响检索与分块预览。
        </Text>
      </Box>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 14, padding: '16px 20px', borderLeft: '4px solid #3B82F6' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0F172A' }}>SSE 流式生成</Text>
        <Text style={{ fontSize: 15, color: '#64748B', marginTop: 6, lineHeight: 1.65 }}>
          生成进度、逐版本、完成事件实时推送，前端边收边渲染。解决「长任务等待焦虑」：离线链路单篇平均 0.10s，接真实 LLM 后同一协议可观测每一步耗时。
        </Text>
      </Box>
    </Box>
  </Box>

  {/* C 区页脚 */}
  <Box style={{ height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
      <Box style={{ width: 10, height: 10, borderRadius: 2, background: 'linear-gradient(135deg, #3B82F6, #06B6D4)' }} />
      <Text style={{ fontSize: 14, color: '#94A3B8' }}>AI 自媒体内容创作助手 · 项目汇报</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>08 / 14</Text>
  </Box>
</Slide>

const FONT = '"Source Han Sans SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif'

<Slide style={{ width: 1280, height: 720, padding: '20px 64px', fontFamily: FONT, background: '#F8FAFC' }}>
  {/* A 区标题块 */}
  <Box style={{ height: 100, justifyContent: 'center' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
      <Box style={{ width: 6, height: 34, background: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)', borderRadius: 3 }} />
      <Box>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A' }}>数据与评测成果</Text>
        <Text style={{ fontSize: 18, color: '#64748B', marginTop: 4 }}>计划书 6.2 四项量化指标：阈值 vs 实测，全部达标</Text>
      </Box>
    </Box>
  </Box>

  {/* B 区：巨型数字 + 洞察 */}
  <Box style={{ flexDirection: 'row', gap: 28, height: 520 }}>
    {/* 左侧主锚点 */}
    <Box style={{ width: 420, background: '#0F172A', borderRadius: 18, padding: '36px 32px', justifyContent: 'center' }}>
      <Text style={{ fontSize: 15, color: '#67E8F9', letterSpacing: 2 }}>素材检索 Top-5 命中率</Text>
      <Text style={{ fontSize: 108, fontWeight: 'bold', lineHeight: 1.05, letterSpacing: -4, marginTop: 10, backgroundImage: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)', backgroundClip: 'text', color: 'transparent' }}>
        100%
      </Text>
      <Text style={{ fontSize: 16, color: '#CBD5E1', marginTop: 14, lineHeight: 1.7 }}>
        阈值 ≥ 90% ｜ 全量 180 条评测任务实测 180/180，五领域全部 100%。
      </Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 18 }}>
        <FAIcon name='check-circle' style={{ fill: '#06B6D4', width: 20, height: 20 }} />
        <Text style={{ fontSize: 14, color: '#94A3B8' }}>消融：关闭重排仅 61.1% —— 重排贡献 +38.9pp</Text>
      </Box>
    </Box>

    {/* 右侧三项指标 + 洞察 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
      <Box style={{ flexDirection: 'row', background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 14, padding: '14px 20px', alignItems: 'center', gap: 18 }}>
        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#3B82F6', width: 150 }}>100%</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>平台适配符合率</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>阈值 ≥90% ｜ 54/54 硬性规范（标题长度 / 标签格式 / 数量上限）</Text>
        </Box>
        <FAIcon name='check-circle' style={{ fill: '#06B6D4', width: 24, height: 24 }} />
      </Box>
      <Box style={{ flexDirection: 'row', background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 14, padding: '14px 20px', alignItems: 'center', gap: 18 }}>
        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#3B82F6', width: 150 }}>100%</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>文案一次可用率</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>阈值 ≥80% ｜ 54/54 版本通过结构规则（离线回归基线）</Text>
        </Box>
        <FAIcon name='check-circle' style={{ fill: '#06B6D4', width: 24, height: 24 }} />
      </Box>
      <Box style={{ flexDirection: 'row', background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 14, padding: '14px 20px', alignItems: 'center', gap: 18 }}>
        <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#3B82F6', width: 150 }}>0.10s</Text>
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A' }}>单篇平均生成耗时</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>阈值 ≤15s ｜ 18 任务实测均值 0.10s、最大 0.17s</Text>
        </Box>
        <FAIcon name='check-circle' style={{ fill: '#06B6D4', width: 24, height: 24 }} />
      </Box>
      <Box style={{ background: 'rgba(59,130,246,0.08)', border: '1px solid rgba(59,130,246,0.25)', borderRadius: 14, padding: '14px 20px', flex: 1, justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, color: '#334155', lineHeight: 1.7 }}>
          数字背后是三次真实迭代：88.9% → 100% 的检索提升，来自补风格加权、召回池 20→40、索引签名自动重建——每个数字都可复现。
        </Text>
      </Box>
    </Box>
  </Box>

  {/* C 区页脚 */}
  <Box style={{ height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
      <Box style={{ width: 10, height: 10, borderRadius: 2, background: 'linear-gradient(135deg, #3B82F6, #06B6D4)' }} />
      <Text style={{ fontSize: 14, color: '#94A3B8' }}>AI 自媒体内容创作助手 · 项目汇报</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>11 / 14</Text>
  </Box>
</Slide>

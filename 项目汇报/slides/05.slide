const FONT = '"Source Han Sans SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif'

<Slide style={{ width: 1280, height: 720, padding: '20px 64px', fontFamily: FONT, background: '#F8FAFC' }}>
  <Box style={{ flexDirection: 'row', gap: 28, height: 620 }}>
    {/* 左侧深色标题栏 */}
    <Box style={{ width: 366, height: 620, background: '#0F172A', borderRadius: 16, padding: 44, justifyContent: 'space-between' }}>
      <Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 52, height: 52, borderRadius: 14, background: 'rgba(59,130,246,0.16)', justifyContent: 'center', alignItems: 'center' }}>
            <FAIcon name='cog' style={{ fill: '#67E8F9', width: 28, height: 28 }} />
          </Box>
          <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>六大功能模块</Text>
        </Box>
        <Box style={{ width: 56, height: 4, background: 'linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%)', borderRadius: 2, marginTop: 26 }} />
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.8, marginTop: 24 }}>
          对应计划书 F1–F6 功能清单，每模块均可独立演示，合起来构成完整创作闭环。
        </Text>
      </Box>
      <Text style={{ fontSize: 13, color: '#475569' }}>F1 – F6 · 模块全景</Text>
    </Box>

    {/* 右侧六模块清单 */}
    <Box style={{ flex: 1, height: 620, justifyContent: 'space-between' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 12, padding: '12px 18px' }}>
        <FAIcon name='folder' style={{ fill: '#3B82F6', width: 26, height: 26 }} />
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A' }}>素材库管理</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>语料导入 / 自动分块 / 加密存储 / 语义检索</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#94A3B8' }}>F1</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 12, padding: '12px 18px' }}>
        <FAIcon name='chart-line' style={{ fill: '#3B82F6', width: 26, height: 26 }} />
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A' }}>热点看板</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>五领域热点采集、热度与趋势可视化</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#94A3B8' }}>F1</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 12, padding: '12px 18px' }}>
        <FAIcon name='star' style={{ fill: '#3B82F6', width: 26, height: 26 }} />
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A' }}>选题策划</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>结合账号人设与热点，一键生成 ≥3 条选题</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#94A3B8' }}>F2</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 12, padding: '12px 18px' }}>
        <FAIcon name='edit' style={{ fill: '#3B82F6', width: 26, height: 26 }} />
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A' }}>文案生成对比</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>RAG 检索增强 + SSE 流式产出多版本对比</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#94A3B8' }}>F3 / F4</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 12, padding: '12px 18px' }}>
        <FAIcon name='share' style={{ fill: '#3B82F6', width: 26, height: 26 }} />
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A' }}>平台适配预览</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>按平台硬性规范逐条适配，支持 txt / docx 导出</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#94A3B8' }}>F5</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '1px solid #E2E8F0', borderRadius: 12, padding: '12px 18px' }}>
        <FAIcon name='user' style={{ fill: '#3B82F6', width: 26, height: 26 }} />
        <Box style={{ flex: 1 }}>
          <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A' }}>账号人设</Text>
          <Text style={{ fontSize: 14, color: '#64748B', marginTop: 2 }}>定位 / 语气 / 领域配置，驱动全链路风格一致</Text>
        </Box>
        <Text style={{ fontSize: 13, color: '#94A3B8' }}>F6</Text>
      </Box>
    </Box>
  </Box>

  {/* C 区页脚 */}
  <Box style={{ height: 60, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
      <Box style={{ width: 10, height: 10, borderRadius: 2, background: 'linear-gradient(135deg, #3B82F6, #06B6D4)' }} />
      <Text style={{ fontSize: 14, color: '#94A3B8' }}>AI 自媒体内容创作助手 · 项目汇报</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>05 / 14</Text>
  </Box>
</Slide>

# 后端运行配置示例（复制为项目根 .env 后按需修改）
# 说明：
# - api/config.py 启动时会自动读取项目根 .env（不覆盖已显式导出的同名环境变量）
# - .env 已被 .gitignore 排除，密钥绝不入库；本文件只放占位符

# -------- LLM（OpenAI 兼容接口）--------
# 留空则走内置 Mock 生成器（离线可演示，但内容是模板）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=1400

# -------- 向量嵌入 --------
EMBEDDING_BACKEND=offline          # offline（零依赖哈希向量）｜ bge（需下载权重）
EMBEDDING_MODEL=BAAI/bge-large-zh
HF_ENDPOINT=https://hf-mirror.com

# -------- 热点采集 V2 --------
# 来源清单（热榜来源码，不是发布平台码 weixin/xhs/douyin）
HOT_SOURCES_ENABLED=weibo,zhihu,baidu,douyin,bilibili,toutiao
# 自托管 DailyHot 实例地址；留空则用内置免费 JSON 源（vvhan / tenapi）
HOTSPOT_API_BASE=
HOTSPOT_TIMEOUT=8
# 定时采集总开关（旧键 HOTSPOT_ENABLED 已废弃，改此键）
HOTSPOT_SCHED_ENABLED=true
# 手动刷新最小间隔（秒）
HOTSPOT_MIN_REFRESH_INTERVAL=60
# 热点退榜阈值（小时）：超过该时长未再上榜即下架
HOTSPOT_SIGNAL_TTL_HOURS=24
# 新颖度窗口（小时）：窗口内首次出现视为"新"
HOTSPOT_NEW_WINDOW_HOURS=24
# 源快照过期判定（分钟）：超过则该源视为不健康
HOTSPOT_SOURCE_STALE_MINUTES=180
HOTSPOT_SUGGESTION_ENABLED=true
# 单次请求最多为几条热点惰性生成「建议角度」（批量 1 次 LLM 调用，控首屏延迟与成本）
HOTSPOT_SUGGESTION_MAX_PER_REQUEST=5
HOTSPOT_MAX_SOURCES_PER_REFRESH=6
# 追加式 raw 层与采集日志的保留天数（不清会无限膨胀）
HOTSPOT_RAW_RETENTION_DAYS=7
HOTSPOT_LOG_RETENTION_DAYS=30
# 推荐流事件（曝光/采纳/出题）保留天数（指标要看趋势，但也不能无限涨）
HOTSPOT_EVENT_RETENTION_DAYS=90
# 同一热点在该窗口内的重复采纳/出题只记一次（双击、严格模式双发、失败重试）
HOTSPOT_ADOPT_DEDUPE_SECONDS=30
# 推荐排序权重：领域命中 / 新颖度 / 覆盖度 / 归一化热度 / 可创作性（和须为 1.0）
HOTSPOT_FEED_WEIGHTS=0.30,0.25,0.20,0.15,0.10
